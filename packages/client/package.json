{
  "name": "@palava/client",
  "version": "4.0.0",
  "description": "Signaling client for WebRTC video-/audio conferencing using the palava protocol",
  "author": "palava e. V.",
  "license": "LGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
